{
  "name": "json-statham",
  "version": "0.3.0",
  "description": "Deterministic JSON contract checks",
  "type": "module",
  "bin": {
    "json-statham": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky",
    "format:check": "prettier --check src test docs examples *.md *.json .github .agent action.yml",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-json-patch": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "types": "./dist/index.d.ts"
}
